{
  "manifest_version": 3,
  "name": "Make Pages Selectable",
  "version": "1.0.0",
  "description": "Makes text selectable on webpages.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
